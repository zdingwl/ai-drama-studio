  "steps": [
    {"id":"source_input","phase":"输入","title":"导入小说","description":"登记小说或故事文本。","capabilities":["SOURCE_TEXT_INGEST"],"requires":[],"produces":["SOURCE_TEXT"]},
    {"id":"novel_adapt","phase":"理解","title":"小说短剧化","description":"理解人物和故事，提炼 Hook、冲突、反转并规划 Episode。","capabilities":["SCRIPT_ANALYSIS","STORY_RHYTHM","NOVEL_ADAPTATION"],"requires":["SOURCE_TEXT"],"produces":["SOURCE_TEXT_SNAPSHOT","STORY_SKELETON","RHYTHM_SKELETON","ADAPTATION_PLAN"]},
    {"id":"target_script","phase":"目标版本","title":"正式短剧剧本","description":"形成可生成的目标剧本和统一目标世界。","capabilities":["TARGET_SCRIPT","TARGET_BIBLE"],"requires":["SOURCE_TEXT_SNAPSHOT","ADAPTATION_PLAN"],"produces":["TARGET_SCRIPT","TARGET_BIBLE"]},
