  "required_capabilities": ["SOURCE_TEXT_INGEST", "SCRIPT_ANALYSIS", "STORY_RHYTHM", "NOVEL_ADAPTATION", "TARGET_SCRIPT", "TARGET_BIBLE", "TARGET_ASSETS", "STORYBOARD", "TTS", "TIMING", "VIDEO_GENERATION", "QC_SELECTION", "LIP_SYNC", "POST_PRODUCTION"],
