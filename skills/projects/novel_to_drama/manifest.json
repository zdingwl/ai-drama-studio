    {"id":"voice_timing","phase":"分镜","title":"配音与生成窗口","description":"生成目标对白音频并形成时间计划和生成片段。","capabilities":["TTS","TIMING"],"requires":["TARGET_SCRIPT","TARGET_STORYBOARD"],"produces":["TARGET_AUDIO","TIMING_PLAN","GENERATION_SEGMENTS"]},
    {"id":"generate","phase":"生成","title":"视频生成与质检","description":"生成镜头、质检并选择正式结果。","capabilities":["VIDEO_GENERATION","QC_SELECTION"],"requires":["GENERATION_SEGMENTS"],"produces":["GENERATED_VIDEO","GENERATION_SELECTION"]},
    {"id":"post","phase":"成片","title":"口型与后期","description":"完成目标短剧成片。","capabilities":["LIP_SYNC","POST_PRODUCTION"],"requires":["GENERATION_SELECTION","TARGET_AUDIO"],"produces":["FINAL_OUTPUT"]}
  ],
  "user_decision_policy": ["改编强度或结局方向不明确且会改变核心故事时询问"],
