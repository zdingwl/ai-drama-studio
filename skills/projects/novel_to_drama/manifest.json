  "output_contracts": ["SOURCE_TEXT_SNAPSHOT", "STORY_SKELETON", "RHYTHM_SKELETON", "TARGET_SCRIPT", "TARGET_BIBLE", "TARGET_STORYBOARD", "FINAL_OUTPUT"],
  "completion_criteria": ["小说已转换为可影视化短剧结构", "目标世界与资产一致", "分镜与正式剧本一致", "最终成片来自正式选择"],
  "failure_policy": ["核心人物或主线无法稳定提取时阻断改编", "生成失败有限重试后阻断"],
