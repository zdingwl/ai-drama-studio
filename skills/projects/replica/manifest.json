{
  "id": "project.replica",
  "name": "复刻短剧",
  "version": "1.0.0",
  "category": "project",
  "description": "保留原剧故事与节奏，把人物、场景、文化和对白替换成目标地区版本并重新生成。",
  "project_type": "REPLICA",
  "when_to_use": ["已有完整原短剧，希望换国家、人物和语言重新拍一遍"],
  "when_not_to_use": ["希望重新编故事", "只需要原画面翻译配音"],
  "required_inputs": ["SOURCE_VIDEO"],
  "readable_artifacts": ["SOURCE_VIDEO", "SHOT_ANCHORS", "SOURCE_DIALOGUE", "SOURCE_BIBLE", "STORY_SKELETON", "RHYTHM_SKELETON", "SOURCE_SHOT_FACTS", "SOURCE_CHARACTERS", "SOURCE_SCENES", "SOURCE_PROPS", "SOURCE_VIDEO_SNAPSHOT", "ADAPTATION_PLAN", "TARGET_BIBLE", "TARGET_SCRIPT", "TARGET_ASSETS", "TARGET_AUDIO", "TIMING_PLAN", "TARGET_STORYBOARD", "GENERATION_SEGMENTS", "GENERATION_SELECTION"],
  "required_capabilities": ["SOURCE_VIDEO_INGEST", "MEDIA_PREFLIGHT", "SHOT_BOUNDARY", "SOURCE_DIALOGUE_EVIDENCE", "EPISODE_UNDERSTANDING", "STORY_RHYTHM", "SHOT_BREAKDOWN", "IDENTITY_RESOLUTION", "SCENE_RESOLUTION", "PROP_RESOLUTION", "SOURCE_SNAPSHOT", "LOCALIZATION", "TARGET_BIBLE", "TARGET_SCRIPT", "TARGET_ASSETS", "TTS", "TIMING", "STORYBOARD", "VIDEO_GENERATION", "QC_SELECTION", "LIP_SYNC", "POST_PRODUCTION"],
  "subskills": ["source-video-understanding", "story-rhythm-analysis", "shot-breakdown", "character-resolution", "scene-resolution", "prop-resolution", "dialogue-localization", "storyboard-directing", "timing-adaptation", "video-generation-qc", "post-production"],
  "manual_path": "replica/SKILL.md",
  "steps": [
    {"id":"source_input","phase":"输入","title":"导入原片","description":"登记原始短剧 Episode。","capabilities":["SOURCE_VIDEO_INGEST"],"requires":[],"produces":["SOURCE_VIDEO"]},
    {"id":"source_evidence","phase":"理解","title":"建立原片证据","description":"完成媒体检查、镜头时间锚点和原对白证据。","capabilities":["MEDIA_PREFLIGHT","SHOT_BOUNDARY","SOURCE_DIALOGUE_EVIDENCE"],"requires":["SOURCE_VIDEO"],"produces":["SHOT_ANCHORS","SOURCE_DIALOGUE"]},
    {"id":"source_story","phase":"理解","title":"整集故事与节奏","description":"先理解整集，再提取故事骨架和节奏骨架。","capabilities":["EPISODE_UNDERSTANDING","STORY_RHYTHM"],"requires":["SOURCE_VIDEO","SHOT_ANCHORS","SOURCE_DIALOGUE"],"produces":["SOURCE_BIBLE","STORY_SKELETON","RHYTHM_SKELETON"]},
    {"id":"source_breakdown","phase":"理解","title":"逐镜拉片与归一","description":"带整集知识做逐镜拉片，并归一人物、场景和关键道具。","capabilities":["SHOT_BREAKDOWN","IDENTITY_RESOLUTION","SCENE_RESOLUTION","PROP_RESOLUTION"],"requires":["SOURCE_BIBLE","SHOT_ANCHORS"],"produces":["SOURCE_SHOT_FACTS","SOURCE_CHARACTERS","SOURCE_SCENES","SOURCE_PROPS"]},
    {"id":"source_finalize","phase":"理解","title":"原片分析定稿","description":"把可追溯的原片事实冻结为下游唯一正式来源。","capabilities":["SOURCE_SNAPSHOT"],"requires":["SOURCE_BIBLE","SOURCE_SHOT_FACTS","SOURCE_CHARACTERS","SOURCE_SCENES","SOURCE_PROPS"],"produces":["SOURCE_VIDEO_SNAPSHOT"]},
    {"id":"target_localize","phase":"目标版本","title":"本土化替换","description":"锁定故事和节奏，建立目标地区人物、场景、道具与剧本。","capabilities":["LOCALIZATION","TARGET_BIBLE","TARGET_SCRIPT"],"requires":["SOURCE_VIDEO_SNAPSHOT","STORY_SKELETON","RHYTHM_SKELETON"],"produces":["ADAPTATION_PLAN","TARGET_BIBLE","TARGET_SCRIPT"]},
    {"id":"target_assets","phase":"目标版本","title":"目标资产","description":"形成可复用的人物、场景和关键道具资产。","capabilities":["TARGET_ASSETS"],"requires":["TARGET_BIBLE"],"produces":["TARGET_ASSETS"]},
    {"id":"voice_timing","phase":"分镜","title":"目标对白与时长","description":"先生成目标配音，再根据真实语音时长做最小必要的节奏适配。","capabilities":["TTS","TIMING"],"requires":["TARGET_SCRIPT"],"produces":["TARGET_AUDIO","TIMING_PLAN"]},
    {"id":"replica_storyboard","phase":"分镜","title":"复刻分镜","description":"把原镜头关系与目标资产组合成可编辑复刻分镜。","capabilities":["STORYBOARD"],"requires":["SOURCE_VIDEO_SNAPSHOT","TARGET_ASSETS","TIMING_PLAN"],"produces":["TARGET_STORYBOARD","GENERATION_SEGMENTS"]},
    {"id":"generate","phase":"生成","title":"视频生成与质检","description":"生成目标镜头，有限重试并选择正式可用结果。","capabilities":["VIDEO_GENERATION","QC_SELECTION"],"requires":["GENERATION_SEGMENTS"],"produces":["GENERATED_VIDEO","GENERATION_SELECTION"]},
    {"id":"post","phase":"成片","title":"口型与后期","description":"完成口型、音频、字幕、剪辑和成片输出。","capabilities":["LIP_SYNC","POST_PRODUCTION"],"requires":["GENERATION_SELECTION","TARGET_AUDIO"],"produces":["FINAL_OUTPUT"]}
  ],
  "user_decision_policy": ["故事或节奏需要偏离原片时必须显式确认", "目标文化存在多个合理方向且会改变人物关系时询问用户"],
  "auto_decision_policy": ["默认锁定故事骨架和节奏骨架", "普通文化替换和对白压缩自动完成"],
  "output_contracts": ["SOURCE_VIDEO_SNAPSHOT", "STORY_SKELETON", "RHYTHM_SKELETON", "TARGET_BIBLE", "TARGET_SCRIPT", "TARGET_STORYBOARD", "FINAL_OUTPUT"],
  "completion_criteria": ["原片分析定稿可追溯", "故事和节奏约束已应用", "目标分镜与目标资产一致", "正式生成选择已完成", "最终成片可导出"],
  "failure_policy": ["缺原片事实则阻断目标生成", "生成失败有限重试后阻断，不伪造成功"],
  "next_recommended_skills": []
}
