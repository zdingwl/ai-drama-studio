{
  "id": "project.redraw",
  "name": "重绘短剧",
  "version": "1.0.0",
  "category": "project",
  "description": "保留原剧情、剪辑与表演结构，重点重新设计并生成视觉。",
  "project_type": "REDRAW",
  "when_to_use": ["已有原视频，希望换演员、时代、服装、场景或视觉风格"],
  "when_not_to_use": ["只需要翻译配音", "希望重新编写故事"],
  "required_inputs": ["SOURCE_VIDEO"],
  "readable_artifacts": ["SOURCE_VIDEO", "SHOT_ANCHORS", "SOURCE_DIALOGUE", "SOURCE_BIBLE", "STORY_SKELETON", "RHYTHM_SKELETON", "SOURCE_SHOT_FACTS", "SOURCE_CHARACTERS", "SOURCE_SPEAKERS", "SOURCE_SCENES", "SOURCE_PROPS", "SOURCE_VIDEO_SNAPSHOT", "ADAPTATION_PLAN", "TARGET_BIBLE", "TARGET_ASSETS", "TIMING_PLAN", "TARGET_STORYBOARD", "GENERATION_SEGMENTS", "GENERATION_SELECTION"],
  "required_capabilities": ["SOURCE_VIDEO_INGEST", "MEDIA_PREFLIGHT", "SHOT_BOUNDARY", "SOURCE_DIALOGUE_EVIDENCE", "EPISODE_UNDERSTANDING", "STORY_RHYTHM", "SHOT_BREAKDOWN", "IDENTITY_RESOLUTION", "SCENE_RESOLUTION", "PROP_RESOLUTION", "SOURCE_SNAPSHOT", "LOCALIZATION", "TARGET_BIBLE", "TARGET_ASSETS", "STORYBOARD", "TIMING", "VIDEO_GENERATION", "QC_SELECTION", "POST_PRODUCTION"],
  "subskills": ["source-video-understanding", "story-rhythm-analysis", "shot-breakdown", "character-resolution", "speaker-attribution", "scene-resolution", "prop-resolution", "source-video-snapshot", "target-world-design", "storyboard-directing", "video-generation-qc", "post-production"],
  "manual_path": "redraw/SKILL.md",
  "steps": [
    {"id":"source_input","phase":"输入","title":"导入原片","description":"登记需要重绘的 Episode。","capabilities":["SOURCE_VIDEO_INGEST"],"requires":[],"produces":["SOURCE_VIDEO"]},
    {"id":"shot_boundary","phase":"理解","title":"镜头技术锚点","description":"从完整 Episode 建立镜头时间锚点、缩略图和参考片段；这是内部技术证据，不等于内容理解。","capabilities":["MEDIA_PREFLIGHT","SHOT_BOUNDARY"],"requires":["SOURCE_VIDEO"],"produces":["SHOT_ANCHORS"]},
    {"id":"source_evidence","phase":"理解","title":"原片对白与文字证据","description":"直接读取完整 Episode 的连续音轨和画面时间轴，提取带时间证据的对白与画面文字；可与镜头技术锚点并行。","capabilities":["SOURCE_DIALOGUE_EVIDENCE"],"requires":["SOURCE_VIDEO"],"produces":["SOURCE_DIALOGUE"]},
    {"id":"source_understand","phase":"理解","title":"源作概览分析","description":"结合完整 Episode 与可追溯 Source Evidence 生成用户可读、可编辑、可版本化的 SOURCE_BIBLE，并同步形成正式 Story/Rhythm Skeleton。","capabilities":["EPISODE_UNDERSTANDING","STORY_RHYTHM"],"requires":["SOURCE_VIDEO","SOURCE_DIALOGUE"],"produces":["SOURCE_BIBLE","STORY_SKELETON","RHYTHM_SKELETON"]},
    {"id":"source_breakdown","phase":"理解","title":"逐镜拉片与最终归一","description":"在整集 Source Bible 与逐镜事实基础上，对 Character、Speaker、Scene、Prop 做跨 Shot/跨 Episode 稳定归一；Speaker 与 Character 分层。","capabilities":["SHOT_BREAKDOWN","IDENTITY_RESOLUTION","SCENE_RESOLUTION","PROP_RESOLUTION"],"requires":["SOURCE_BIBLE","SHOT_ANCHORS"],"produces":["SOURCE_SHOT_FACTS","SOURCE_CHARACTERS","SOURCE_SPEAKERS","SOURCE_SCENES","SOURCE_PROPS"]},
    {"id":"source_finalize","phase":"理解","title":"原片分析定稿","description":"不重新调用模型，把 P5~P9 已验收 CURRENT Source Facts 确定性冻结为重绘下游的正式 Source 边界。","capabilities":["SOURCE_SNAPSHOT"],"requires":["SOURCE_VIDEO","SHOT_ANCHORS","SOURCE_DIALOGUE","SOURCE_BIBLE","STORY_SKELETON","RHYTHM_SKELETON","SOURCE_SHOT_FACTS","SOURCE_CHARACTERS","SOURCE_SPEAKERS","SOURCE_SCENES","SOURCE_PROPS"],"produces":["SOURCE_VIDEO_SNAPSHOT"]},
    {"id":"visual_plan","phase":"目标版本","title":"视觉重绘方案","description":"确定目标人物、场景、时代和视觉风格。","capabilities":["LOCALIZATION","TARGET_BIBLE","TARGET_ASSETS"],"requires":["SOURCE_VIDEO_SNAPSHOT"],"produces":["ADAPTATION_PLAN","TARGET_BIBLE","TARGET_ASSETS"]},
    {"id":"storyboard","phase":"分镜","title":"重绘分镜","description":"保持原剪辑和表演关系，生成目标视觉分镜。","capabilities":["STORYBOARD","TIMING"],"requires":["SOURCE_VIDEO_SNAPSHOT","TARGET_ASSETS"],"produces":["TIMING_PLAN","TARGET_STORYBOARD","GENERATION_SEGMENTS"]},
    {"id":"generate","phase":"生成","title":"重绘生成与质检","description":"逐段重绘并选择正式结果。","capabilities":["VIDEO_GENERATION","QC_SELECTION"],"requires":["GENERATION_SEGMENTS"],"produces":["GENERATED_VIDEO","GENERATION_SELECTION"]},
    {"id":"post","phase":"成片","title":"音频与后期","description":"按项目音频策略挂回或重建音频并输出成片。","capabilities":["POST_PRODUCTION"],"requires":["GENERATION_SELECTION"],"produces":["FINAL_OUTPUT"]}
  ],
  "user_decision_policy": ["视觉风格存在显著不同方向且项目未指定时询问", "用户修改或合规微调 SOURCE_BIBLE 时保留为新 revision，并使依赖旧版本的逐镜拉片和后续结果 STALE"],
  "auto_decision_policy": ["默认不改故事", "默认保持原剪辑和表演关系", "理解模型不得用摘要或合规改写静默覆盖 canonical Source Evidence"],
  "output_contracts": ["SOURCE_VIDEO_SNAPSHOT", "TARGET_BIBLE", "TARGET_ASSETS", "TARGET_STORYBOARD", "FINAL_OUTPUT"],
  "completion_criteria": ["源作概览分析 SOURCE_BIBLE 可读、可追溯且版本明确", "原片结构与稳定 Source identity 已正式定稿", "目标视觉方案一致", "最终成片来自正式选择"],
  "failure_policy": ["缺任一原片正式 Source Fact 时阻断重绘", "生成失败有限重试后阻断"],
  "next_recommended_skills": []
}
