{
  "id": "project.script_to_drama",
  "name": "剧本生成短剧",
  "version": "1.2.0",
  "category": "project",
  "description": "输入完整剧本，建立可追溯 Source Truth、目标世界与导演分镜，再生成正式资产图、模型专属 H3 Prompt、音画镜头，经过人工选片后用 FFmpeg 合成成片；工程链已接通，真实 Provider 质量仍需项目级验收。",
  "project_type": "SCRIPT_TO_DRAMA",
  "when_to_use": [
    "已有剧本，希望据此制作短剧"
  ],
  "when_not_to_use": [
    "原作是小说",
    "只需剧本跨文化本土化，不生成影像"
  ],
  "required_inputs": [
    "SOURCE_TEXT"
  ],
  "readable_artifacts": [
    "SOURCE_TEXT",
    "SOURCE_TEXT_SNAPSHOT",
    "STORY_SKELETON",
    "RHYTHM_SKELETON",
    "TARGET_BIBLE",
    "TARGET_SCRIPT",
    "TARGET_ASSETS",
    "TARGET_ASSET_IMAGES",
    "TARGET_STORYBOARD",
    "TARGET_AUDIO",
    "TIMING_PLAN",
    "GENERATION_SEGMENTS",
    "GENERATION_SELECTION"
  ],
  "required_capabilities": [
    "SOURCE_TEXT_INGEST",
    "SCRIPT_ANALYSIS",
    "STORY_RHYTHM",
    "TARGET_BIBLE",
    "TARGET_ASSETS",
    "STORYBOARD",
    "MODEL_PROMPTING",
    "ASSET_IMAGE_GENERATION",
    "VIDEO_GENERATION",
    "QC_SELECTION",
    "POST_PRODUCTION"
  ],
  "subskills": [
    "script-analysis",
    "script-world-design",
    "script-storyboard-directing"
  ],
  "manual_path": "script_to_drama/SKILL.md",
  "steps": [
    {
      "id": "source_input",
      "phase": "输入",
      "title": "导入完整剧本",
      "description": "复用不可变文本上传与版本链。",
      "capabilities": [
        "SOURCE_TEXT_INGEST"
      ],
      "requires": [],
      "produces": [
        "SOURCE_TEXT"
      ]
    },
    {
      "id": "script_analyze",
      "phase": "预制作",
      "title": "剧本结构化理解",
      "description": "正式运行：按原文连续分段执行 script-analysis，冻结全量 Source Truth 和节奏。",
      "capabilities": [
        "SCRIPT_ANALYSIS",
        "STORY_RHYTHM"
      ],
      "requires": [
        "SOURCE_TEXT"
      ],
      "produces": [
        "SOURCE_TEXT_SNAPSHOT",
        "STORY_SKELETON",
        "RHYTHM_SKELETON"
      ]
    },
    {
      "id": "target_world",
      "phase": "预制作",
      "title": "目标世界与可视资产定义",
      "description": "正式运行：逐段建立人物、场景、重要道具 registry；定义不等于已生成资产图片。",
      "capabilities": [
        "TARGET_BIBLE",
        "TARGET_ASSETS"
      ],
      "requires": [
        "SOURCE_TEXT_SNAPSHOT",
        "STORY_SKELETON",
        "RHYTHM_SKELETON"
      ],
      "produces": [
        "TARGET_BIBLE",
        "TARGET_ASSETS"
      ]
    },
    {
      "id": "director_storyboard",
      "phase": "预制作",
      "title": "导演分镜计划",
      "description": "正式运行：逐段回指原文并绑定目标世界实体，不生成真实视频。",
      "capabilities": [
        "STORYBOARD"
      ],
      "requires": [
        "SOURCE_TEXT_SNAPSHOT",
        "TARGET_BIBLE",
        "TARGET_ASSETS"
      ],
      "produces": [
        "TARGET_STORYBOARD"
      ]
    },
    {
      "id": "asset_images",
      "phase": "生成",
      "title": "首帧与资产出图",
      "description": "工程接入：从独立 TARGET_ASSETS/TARGET_STORYBOARD 生成模型专属资产 Prompt 和正式人物/场景/道具参考图；复用底层图片 Runtime，不写入 Replica 专属资产表。",
      "capabilities": [
        "ASSET_IMAGE_GENERATION"
      ],
      "requires": [
        "TARGET_ASSETS",
        "TARGET_STORYBOARD"
      ],
      "produces": [
        "TARGET_ASSET_IMAGES"
      ]
    },
    {
      "id": "model_prompt",
      "phase": "生成",
      "title": "视频模型专属 Prompt",
      "description": "工程接入：消费正式导演分镜和资产图，使用已注册的 MiniMax H3 Professional Skill 编译 GenerationSegment、Prompt 与 1..9 参考图槽位。",
      "capabilities": [
        "MODEL_PROMPTING"
      ],
      "requires": [
        "TARGET_STORYBOARD",
        "TARGET_ASSET_IMAGES"
      ],
      "produces": [
        "GENERATION_SEGMENTS"
      ]
    },
    {
      "id": "generate",
      "phase": "生成",
      "title": "镜头生成与人工选择",
      "description": "工程接入：调用当前 H3 Runtime 生成每个音画分段，执行文件、时长与媒体技术校验；生成结果必须经用户明确确认后才形成正式选片。",
      "capabilities": [
        "VIDEO_GENERATION",
        "QC_SELECTION"
      ],
      "requires": [
        "GENERATION_SEGMENTS",
        "TARGET_ASSET_IMAGES"
      ],
      "produces": [
        "GENERATED_VIDEO",
        "GENERATION_SELECTION"
      ]
    },
    {
      "id": "post",
      "phase": "成片",
      "title": "成片与导出",
      "description": "工程接入：只消费人工确认的 GENERATION_SELECTION，使用 FFmpeg 合成为 H.264/AAC MP4；真实模型质量和最终观感仍需人工验收。",
      "capabilities": [
        "POST_PRODUCTION"
      ],
      "requires": [
        "GENERATION_SELECTION"
      ],
      "produces": [
        "FINAL_OUTPUT"
      ]
    }
  ],
  "user_decision_policy": [
    "核心剧情冲突、人物关系或连续性无法从原文确定时，停止下游自动发布并交人工确认"
  ],
  "auto_decision_policy": [
    "不擅自改写主线，只补足明确标记为视觉推断的可生成信息"
  ],
  "output_contracts": [
    "SOURCE_TEXT_SNAPSHOT",
    "TARGET_BIBLE",
    "TARGET_ASSETS",
    "TARGET_STORYBOARD",
    "TARGET_ASSET_IMAGES",
    "GENERATION_SEGMENTS",
    "GENERATION_SELECTION",
    "FINAL_OUTPUT"
  ],
  "completion_criteria": [
    "完整源剧本被分段分析且可回溯，无静默截断",
    "目标世界、资产定义与导演分镜保持原剧本因果和稳定实体 ID",
    "正式资产图与 H3 Prompt 精确覆盖下游所需实体/生成分段",
    "全部视频分段通过技术校验并经过用户明确选片确认",
    "FINAL_OUTPUT 只从正式选片合成；真实 Provider 画面质量与最终观感需人工验收"
  ],
  "failure_policy": [
    "每段模型上下文/输出失败时不发布残缺结果，保留检查点以续跑",
    "上游版本变化则阻断旧下游发布并通过 Artifact 图使旧结果过期",
    "图片/H3 Runtime 不可用或参考图超出模型合同则明确失败，禁止无参考图静默退化",
    "未人工确认生成镜头时禁止进入正式成片合成",
    "任何新项目实现不得放宽 REPLICA 专属 API 的项目类型门禁"
  ],
  "next_recommended_skills": []
}
