AI_DRAMA_ENVIRONMENT=development
# 相对路径统一以 backend/ 为基准，不再依赖当前 PowerShell 工作目录。
AI_DRAMA_DATABASE_URL=sqlite:///./data/ai_drama_studio.db
AI_DRAMA_ARTIFACT_ROOT=./artifacts
AI_DRAMA_TIMEZONE=UTC

# P6 Source Evidence：本地 ASR/OCR。生产/验收可覆盖模型与设备。
AI_DRAMA_P6_ASR_PROVIDER=faster-whisper
AI_DRAMA_P6_ASR_MODEL=small
AI_DRAMA_P6_ASR_DEVICE=auto
AI_DRAMA_P6_ASR_COMPUTE_TYPE=default
# AI_DRAMA_P6_ASR_DOWNLOAD_ROOT=./models/whisper
AI_DRAMA_P6_OCR_PROVIDER=rapidocr
AI_DRAMA_P6_OCR_SAMPLE_INTERVAL_MS=500
AI_DRAMA_P6_OCR_MIN_CONFIDENCE=0.45
