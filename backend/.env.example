AI_DRAMA_ENVIRONMENT=development
# 相对路径统一以 backend/ 为基准，不再依赖当前 PowerShell 工作目录。
AI_DRAMA_DATABASE_URL=sqlite:///./data/ai_drama_studio.db
AI_DRAMA_ARTIFACT_ROOT=./artifacts
AI_DRAMA_TIMEZONE=UTC

# P6 Source Evidence：本地 ASR/OCR。生产/验收可覆盖模型与设备。
# P6 v2 默认使用 large-v3-turbo；仍然对完整 Episode 连续音轨做一次 ASR，不按 Shot 切分。
AI_DRAMA_P6_ASR_PROVIDER=faster-whisper
AI_DRAMA_P6_ASR_MODEL=large-v3-turbo
AI_DRAMA_P6_ASR_DEVICE=auto
AI_DRAMA_P6_ASR_COMPUTE_TYPE=default
# AI_DRAMA_P6_ASR_DOWNLOAD_ROOT=./models/whisper
AI_DRAMA_P6_OCR_PROVIDER=rapidocr
AI_DRAMA_P6_OCR_SAMPLE_INTERVAL_MS=500
AI_DRAMA_P6_OCR_MIN_CONFIDENCE=0.45

# P7 Source Understanding：用户在项目设置中三选一。
# 1) Doubao Seed 2.1 Pro / 火山 API
# 2) Qwen3.8-27B / 本地 vLLM，高质量
# 3) Qwen3-VL-8B-Thinking / 本地 vLLM，低显存兼容
# 模型选择写入 Project；运行时连接参数由项目工作区“本机运行时连接配置”直接编辑本机 backend/.env。
# API Key 可以在该本机开发/验收界面明文填写与回显，但仍不得写入 DB / Artifact / ProviderJob / Git。

# 模型 A：Doubao Seed 2.1 Pro / 火山引擎方舟 API。
AI_DRAMA_P7_DOUBAO_MODEL=doubao-seed-2-1-pro-260628
AI_DRAMA_P7_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_DRAMA_P7_DOUBAO_REQUEST_TIMEOUT_SECONDS=1800
AI_DRAMA_P7_DOUBAO_VIDEO_FPS=1.0
# 可在页面填写，或手工写入本地 .env；不要提交真实密钥。
# AI_DRAMA_P7_DOUBAO_API_KEY=your-ark-api-key

# 模型 B：Qwen3.8-27B，本地高质量档。默认监听 8000。
AI_DRAMA_P7_QWEN38_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
AI_DRAMA_P7_QWEN38_LOCAL_MODEL=Qwen/Qwen3.8-27B
# 如果该 vLLM 使用 --api-key，再配置；未启用鉴权可留空。
# AI_DRAMA_P7_QWEN38_LOCAL_API_KEY=your-local-vllm-api-key

# 模型 C：Qwen3-VL-8B-Thinking，本地低显存档。默认监听 8001。
AI_DRAMA_P7_QWEN3_VL_8B_LOCAL_BASE_URL=http://127.0.0.1:8001/v1
AI_DRAMA_P7_QWEN3_VL_8B_LOCAL_MODEL=Qwen/Qwen3-VL-8B-Thinking
# AI_DRAMA_P7_QWEN3_VL_8B_LOCAL_API_KEY=your-local-vllm-api-key

AI_DRAMA_P7_QWEN_LOCAL_REQUEST_TIMEOUT_SECONDS=3600

# 两个本地 Qwen 都必须与 backend 共享完整 Episode 文件路径，并允许 vLLM 读取该目录。
# tensor parallel / quantization / max-model-len 请按实际 GPU 显存设置，不在应用里写死。
# 高质量档示例：
# vllm serve Qwen/Qwen3.8-27B --port 8000 \
#   --allowed-local-media-path /absolute/path/to/backend/artifacts \
#   --limit-mm-per-prompt.video 1
#
# 低显存档示例：
# vllm serve Qwen/Qwen3-VL-8B-Thinking --port 8001 \
#   --allowed-local-media-path /absolute/path/to/backend/artifacts \
#   --limit-mm-per-prompt.video 1
#
# 如果使用能够按 model 路由的统一 OpenAI-compatible 网关，可以把两个 BASE_URL 配成同一地址。

# P14 Target Audio：OpenAI-compatible /audio/speech endpoint。
# 当前只是工程运行时配置；真实 Provider 与人工听审 PASS 前 TTS/TIMING 仍是 PLANNED。
AI_DRAMA_P14_TTS_BASE_URL=http://127.0.0.1:8002/v1
AI_DRAMA_P14_TTS_MODEL=tts-1
AI_DRAMA_P14_TTS_RESPONSE_FORMAT=wav
AI_DRAMA_P14_TTS_REQUEST_TIMEOUT_SECONDS=300
# AI_DRAMA_P14_TTS_API_KEY=your-tts-api-key

# P14 Voice Catalog：普通用户只选择 voice_key/display_name；provider_voice_id 仅服务端可见。
# 默认必须为空，禁止伪造可用声线。接入真实 Provider 后按真实 voice id 配置一行 JSON。
AI_DRAMA_P14_TTS_VOICE_CATALOG_JSON=[]
# 示例（请替换成真实 Provider 声线，不要照抄）：
# AI_DRAMA_P14_TTS_VOICE_CATALOG_JSON=[{"voice_key":"warm_female_01","display_name":"Warm Female 01","provider_voice_id":"REAL_PROVIDER_VOICE_ID","locale":"en-US","tags":["female","warm"]}]
