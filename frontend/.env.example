# Local Vite development proxy target.
# Default when omitted: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: override the browser-facing API base URL for deployments.
# Leave unset for normal local development so requests use /api/v3 through the Vite proxy.
# VITE_API_BASE_URL=/api/v3
